+impl Borrow<str> for RequestId {
+    fn borrow(&self) -> &str {
+        self.as_str()
+    }
+}
+
+impl Drop for RequestId {
+    fn drop(&mut self) {
+        if let Some(value) = Arc::get_mut(&mut self.0) {
+            zeroize_string(value);
+        }
+    }
